{
  "name": "cdoing-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "yarn workspace @cdoing/core build && yarn workspace @cdoing/ai build && yarn workspace @cdoing/cli dev",
    "clean": "turbo run clean",
    "remote": "yarn build && yarn workspace @cdoing/remote-coding-agent start",
    "remote:setup": "yarn build && yarn workspace @cdoing/remote-coding-agent setup",
    "remote:tui": "yarn build && yarn workspace @cdoing/remote-coding-agent tui",
    "remote:dashboard": "yarn build && yarn workspace @cdoing/remote-coding-agent dashboard",
    "remote:status": "yarn build && yarn workspace @cdoing/remote-coding-agent status",
    "remote:skills": "yarn build && yarn workspace @cdoing/remote-coding-agent skills",
    "remote-tui": "yarn build && yarn workspace @cdoing/remote-agent-tui start",
    "remote-tui:setup": "yarn build && yarn workspace @cdoing/remote-agent-tui start:setup"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
