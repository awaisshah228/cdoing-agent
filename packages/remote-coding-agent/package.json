{
  "name": "@cdoing/remote-coding-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-channel remote coding agent — control your AI coding assistant from Telegram, Discord, WhatsApp, or any channel",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "remote-coding-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --watch --inspect dist/cli.js dashboard",
    "dev:start": "tsc && node --watch --inspect dist/cli.js start",
    "dev:setup": "tsc && node dist/cli.js setup",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js start",
    "setup": "node dist/cli.js setup",
    "tui": "node dist/cli.js tui",
    "dashboard": "node dist/cli.js dashboard",
    "status": "node dist/cli.js status",
    "skills": "node dist/cli.js skills",
    "login": "node dist/cli.js login --oauth",
    "login:status": "node dist/cli.js login --status"
  },
  "dependencies": {
    "@cdoing/core": "*",
    "@cdoing/ai": "*",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.8",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/react": "^18.2.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "remote",
    "coding-agent",
    "telegram",
    "discord",
    "ai",
    "cli",
    "bot",
    "multi-channel"
  ],
  "license": "Apache-2.0"
}
