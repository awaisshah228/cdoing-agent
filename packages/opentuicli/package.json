{
  "name": "@cdoing/opentuicli",
  "version": "2.0.1",
  "description": "OpenTUI-based terminal interface for cdoing agent (inspired by opencode's TUI)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opentuicli": "bin/cdoing-tui.cjs",
    "cdoing-tui": "bin/cdoing-tui.cjs"
  },
  "files": [
    "bin/",
    "postinstall.mjs"
  ],
  "scripts": {
    "build:single": "bun run build.ts --single",
    "build:dev": "bun run build.ts --single && node postinstall.mjs",
    "build:all": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "dev": "bun --preload ./preload.ts --watch src/index.ts",
    "start": "./dist/cdoing-tui-current/bin/cdoing-tui",
    "postinstall": "node postinstall.mjs",
    "publish": "bun run script/publish.ts",
    "publish:dry": "bun run script/publish.ts --dry-run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@cdoing/ai": "*",
    "@cdoing/core": "*",
    "@opentui/core": "0.1.88",
    "@opentui/react": "0.1.88",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-reconciler": "^0.32.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "zustand": "^5.0.12"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "open": "^11.0.0"
  }
}
