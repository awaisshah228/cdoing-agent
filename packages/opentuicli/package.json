{
  "name": "@cdoing/opentuicli",
  "version": "0.1.6",
  "description": "OpenTUI-based terminal interface for cdoing agent (inspired by opencode's TUI)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cdoing-tui": "dist/index.js"
  },
  "scripts": {
    "build": "node esbuild.config.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "node esbuild.config.cjs --watch",
    "start": "bun dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cdoing/ai": "0.1.5",
    "@cdoing/core": "0.1.8",
    "@opentui/core": "0.1.87",
    "@opentui/react": "0.1.87",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "license": "Apache-2.0"
}
