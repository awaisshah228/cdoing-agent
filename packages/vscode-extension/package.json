{
  "name": "cdoing-vscode",
  "displayName": "Cdoing Agent",
  "description": "AI-powered coding assistant with multi-model support — chat, instruct, and run commands right from VS Code",
  "version": "0.1.29",
  "publisher": "awaisshah228",
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaisshah228/cdoing-agent"
  },
  "homepage": "https://github.com/awaisshah228/cdoing-agent",
  "bugs": {
    "url": "https://github.com/awaisshah228/cdoing-agent/issues"
  },
  "keywords": [
    "ai",
    "coding assistant",
    "claude",
    "openai",
    "gpt",
    "gemini",
    "ollama",
    "copilot",
    "chat",
    "agent",
    "multi-model",
    "code generation",
    "refactor",
    "inline edit",
    "autocomplete"
  ],
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cdoing",
          "title": "Cdoing Agent",
          "icon": "media/sidebar-icon.png"
        }
      ]
    },
    "views": {
      "cdoing": [
        {
          "type": "webview",
          "id": "cdoing.chatPanel",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "cdoing.newChat",
        "title": "Cdoing: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "cdoing.clearHistory",
        "title": "Cdoing: Clear Chat History"
      },
      {
        "command": "cdoing.openEditorPanel",
        "title": "Cdoing: Open Chat Panel (Beside Editor)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.selectModel",
        "title": "Cdoing: Select Model"
      },
      {
        "command": "cdoing.openSettings",
        "title": "Cdoing: Open Settings"
      },
      {
        "command": "cdoing.sendSelection",
        "title": "Cdoing: Send Selection to Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.explainSelection",
        "title": "Cdoing: Explain Selection",
        "icon": "$(lightbulb)"
      },
      {
        "command": "cdoing.refactorSelection",
        "title": "Cdoing: Refactor Selection"
      },
      {
        "command": "cdoing.fixSelection",
        "title": "Cdoing: Fix Selection"
      },
      {
        "command": "cdoing.openFile",
        "title": "Cdoing: Ask About This File",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.addToChat",
        "title": "Cdoing: Add to Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.moveToSecondarySidebar",
        "title": "Cdoing: Move to Right Sidebar"
      },
      {
        "command": "cdoing.moveToPrimarySidebar",
        "title": "Cdoing: Move to Left Sidebar"
      },
      {
        "command": "cdoing.openChatPanel",
        "title": "Cdoing: Open Chat Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.focusSidebar",
        "title": "Cdoing: Focus Chat Sidebar"
      },
      {
        "command": "cdoing.focusChat",
        "title": "Cdoing: Focus Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cdoing.addFileRefToChat",
        "title": "Cdoing: Add File Reference to Chat",
        "icon": "$(references)"
      },
      {
        "command": "cdoing.fixDiagnostics",
        "title": "Cdoing: Fix Diagnostics with AI"
      },
      {
        "command": "cdoing.toggleAutocomplete",
        "title": "Cdoing: Toggle Autocomplete"
      },
      {
        "command": "cdoing.indexCodebase",
        "title": "Cdoing: Index Codebase",
        "icon": "$(database)"
      },
      {
        "command": "cdoing.indexCodebaseStats",
        "title": "Cdoing: Show Index Stats"
      },
      {
        "command": "cdoing.indexCodebaseFull",
        "title": "Cdoing: Rebuild Index (Full)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cdoing.openFile",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ],
      "view/title": [
        {
          "command": "cdoing.openChatPanel",
          "group": "navigation",
          "when": "view == cdoing.chatPanel"
        },
        {
          "command": "cdoing.newChat",
          "group": "navigation",
          "when": "view == cdoing.chatPanel"
        }
      ],
      "editor/context": [
        {
          "command": "cdoing.addToChat",
          "group": "cdoing@0",
          "when": "editorHasSelection"
        },
        {
          "command": "cdoing.sendSelection",
          "group": "cdoing@1",
          "when": "editorHasSelection"
        },
        {
          "command": "cdoing.explainSelection",
          "group": "cdoing@2",
          "when": "editorHasSelection"
        },
        {
          "command": "cdoing.refactorSelection",
          "group": "cdoing@3",
          "when": "editorHasSelection"
        },
        {
          "command": "cdoing.fixSelection",
          "group": "cdoing@4",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Cdoing Agent",
      "properties": {
        "cdoing.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "google",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "Anthropic (Claude)",
            "OpenAI (GPT)",
            "Google (Gemini)",
            "Ollama (Local models)",
            "Custom OpenAI-compatible provider"
          ],
          "description": "AI model provider"
        },
        "cdoing.model": {
          "type": "string",
          "default": "",
          "description": "Model name (leave empty for provider default). Examples: claude-sonnet-4-20250514, gpt-4o, gemini-2.0-flash"
        },
        "cdoing.customProviderName": {
          "type": "string",
          "default": "",
          "description": "Name for custom provider (e.g., ollama, together, groq)"
        },
        "cdoing.customBaseURL": {
          "type": "string",
          "default": "",
          "description": "Base URL for custom provider (e.g., http://localhost:11434)"
        },
        "cdoing.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key (overrides environment variable). Leave empty to use env var."
        },
        "cdoing.authMethod": {
          "type": "string",
          "default": "apiKey",
          "enum": [
            "apiKey",
            "oauth"
          ],
          "enumDescriptions": [
            "Use an API key (from settings or environment variable)",
            "Use Claude OAuth login (free tier, Haiku only)"
          ],
          "description": "Authentication method for Anthropic provider"
        },
        "cdoing.temperature": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2,
          "description": "Model temperature (0 = deterministic, higher = more creative)"
        },
        "cdoing.maxTokens": {
          "type": "number",
          "default": 8096,
          "description": "Maximum tokens in model response"
        },
        "cdoing.permissionMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "auto-edit",
            "auto"
          ],
          "enumDescriptions": [
            "Ask before any tool requiring permission",
            "Auto-approve file edits, ask for shell commands",
            "Auto-approve all operations"
          ],
          "description": "Permission mode for tool execution"
        },
        "cdoing.autocomplete.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline code completions (ghost text suggestions as you type)"
        },
        "cdoing.autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "Model for autocomplete (leave empty to use a fast default like claude-haiku-4-5). A smaller/faster model is recommended."
        }
      }
    },
    "keybindings": [
      {
        "command": "cdoing.openEditorPanel",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "cdoing.sendSelection",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorHasSelection"
      },
      {
        "command": "cdoing.focusChat",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "cdoing.addFileRefToChat",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorIsOpen"
      },
      {
        "command": "cdoing.indexCodebase",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "clean": "rm -rf dist",
    "package": "vsce package"
  },
  "dependencies": {
    "@cdoing/ai": "*",
    "@cdoing/core": "*",
    "better-sqlite3": "^11.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.2"
  }
}
